@model IEnumerable<ShelfShare.Entity.Concrete.Group>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<a asp-action="Create" class="btn btn-primary">Yeni Grup Oluştur</a>

<table class="table mt-3">
    <thead>
        <tr>
            <th>Grup Adı</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var group in Model)
        {
            <tr>
                <td>@group.Name</td>
            </tr>
        }
    </tbody>
</table>

