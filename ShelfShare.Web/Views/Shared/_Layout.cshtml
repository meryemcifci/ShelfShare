@using Microsoft.AspNetCore.Identity
@using ShelfShare.Entity.Concrete
@inject UserManager<AppUser> UserManager
@inject SignInManager<AppUser> SignInManager
﻿
<!DOCTYPE html>
<html lang="en">
<head>
    <title>@ViewData["Title"] - ShelfShare</title>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Raleway:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

    <!-- Vendor CSS Files -->
    <link href="~/kelly-1.0.0/kelly-1.0.0/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/kelly-1.0.0/kelly-1.0.0/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/kelly-1.0.0/kelly-1.0.0/assets/vendor/aos/aos.css" rel="stylesheet" />
    <link href="~/kelly-1.0.0/kelly-1.0.0/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet" />
    <link href="~/kelly-1.0.0/kelly-1.0.0/assets/vendor/glightbox/css/glightbox.css" rel="stylesheet" />

    <!-- Main CSS File -->
    <link href="~/kelly-1.0.0/kelly-1.0.0/assets/css/main.css" rel="stylesheet" />

</head>
<body>
    <header id="header" class="header d-flex align-items-center light-background sticky-top">
        <div class="container-fluid position-relative d-flex align-items-center justify-content-between">

            <a href="index.html" class="logo d-flex align-items-center me-auto me-xl-0">
    @*             <img src="~/images/ShelfShare-AcikTema.png" alt="ShelfShare">
     *@            <h1 class="sitename">Shelf Share</h1>
            </a>

            <nav id="navmenu" class="navmenu">
                <ul>

                    <li><a asp-area ="" asp-controller="Home" asp-action="Index">Anasayfa</a></li>
                    <li><a asp-area ="" asp-controller="Home" asp-action="About">Hakkımızda</a></li>
                    <li><a asp-area ="" asp-controller="Home" asp-action="Contact">İletişim</a></li>

                      @if (User.Identity.IsAuthenticated)
                     { 

                        <li><a asp-area="" asp-controller="Library" asp-action="Index">Kütüphanem</a></li>
                        <li><a asp-area="" asp-controller="Group" asp-action="Index">Gruplar</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="userDropdown"
                               role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @if (SignInManager.IsSignedIn(User))
                                {
                                    var user = await UserManager.GetUserAsync(User);
                                    @user.FirstName
                                }
                                else
                                {
                                    <text>Profilim</text>
                                }
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="userDropdown">
                                <li><a class="dropdown-item" href="/User/Profile">Profilim</a></li>
                                <li><a class="dropdown-item" href="/User/MyBooks">Kitaplarım</a></li>
                                <li><a class="dropdown-item" href="/User/MyReviews">İncelemelerim</a></li>
                                <li><a class="dropdown-item" href="/User/ReadingList">Okuma Listem</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" href="/Account/Logout">Çıkış Yap</a></li>
                            </ul>
                        </li>
                     } 
                    <partial name="_LoginPartial" />
                </ul>
                <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
            </nav>

            <div class="header-social-links">
                <a href="#" class="twitter"><i class="bi bi-twitter-x"></i></a>
                <a href="#" class="facebook"><i class="bi bi-facebook"></i></a>
                <a href="#" class="instagram"><i class="bi bi-instagram"></i></a>
                <a href="#" class="linkedin"><i class="bi bi-linkedin"></i></a>
            </div>

        </div>
    </header>
    @RenderBody()
   
    <footer id="footer" class="footer light-background">

        <div class="container">
            <div class="copyright text-center ">
                &copy; 2025 - ShelfShare.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
            <div class="social-links d-flex justify-content-center">
                <a href=""><i class="bi bi-twitter-x"></i></a>
                <a href=""><i class="bi bi-facebook"></i></a>
                <a href=""><i class="bi bi-instagram"></i></a>
                <a href=""><i class="bi bi-linkedin"></i></a>
            </div>
        </div>

    </footer>
    <!-- Scroll Top -->
    <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>
   

    <!-- Vendor JS Files -->
    <script src="~/kelly-1.0.0/kelly-1.0.0/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/kelly-1.0.0/kelly-1.0.0/assets/vendor/php-email-form/validate.js"></script>
    <script src="~/kelly-1.0.0/kelly-1.0.0/assets/vendor/aos/aos.js"></script>
    <script src="~/kelly-1.0.0/kelly-1.0.0/assets/vendor/waypoints/noframework.waypoints.js"></script>
    <script src="~/kelly-1.0.0/kelly-1.0.0/assets/vendor/purecounter/purecounter_vanilla.js"></script>
    <script src="~/kelly-1.0.0/kelly-1.0.0/assets/vendor/swiper/swiper-bundle.min.js"></script>
    <script src="~/kelly-1.0.0/kelly-1.0.0/assets/vendor/glightbox/js/glightbox.min.js"></script>
    <script src="~/kelly-1.0.0/kelly-1.0.0/assets/vendor/imagesloaded/imagesloaded.pkgd.min.js"></script>
    <script src="~/kelly-1.0.0/kelly-1.0.0/assets/vendor/isotope-layout/isotope.pkgd.min.js"></script>

    <!-- Main JS File -->
    <script src="~/kelly-1.0.0/kelly-1.0.0/assets/js/main.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
