                        <a class="nav-link dropdown-toggle text-dark" href="#" id="userDropdown"
                           role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            @if (SignInManager.IsSignedIn(User))
                            {
                                var user = await UserManager.GetUserAsync(User);
                                @user.FirstName
                            }
                            else
                            {
                                <text>Profilim</text>
                            }
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="userDropdown">
                            <li><a class="dropdown-item" href="/Account/Profile">Profilim</a></li>
                            <li><a class="dropdown-item" href="/Books/MyBooks">Kitaplarım</a></li>
                            <li><a class="dropdown-item" href="/Reviews/MyReviews">İncelemelerim</a></li>
                            <li><a class="dropdown-item" href="/ReadingList">Okuma Listem</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" href="/Account/Logout">Çıkış Yap</a></li>
                        </ul>
                    </li>
                }
                <partial name="_LoginPartial" />
            </ul>
            <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
        </nav>

        <div class="header-social-links">
            <a href="#" class="twitter"><i class="bi bi-twitter-x"></i></a>
            <a href="#" class="facebook"><i class="bi bi-facebook"></i></a>
            <a href="#" class="instagram"><i class="bi bi-instagram"></i></a>
            <a href="#" class="linkedin"><i class="bi bi-linkedin"></i></a>
        </div>

    </div>
</header>

<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer id="footer" class="footer light-background">

    <div class="container">
        <div class="copyright text-center ">
            &copy; 2025 - ShelfShare.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
        <div class="social-links d-flex justify-content-center">
            <a href=""><i class="bi bi-twitter-x"></i></a>
            <a href=""><i class="bi bi-facebook"></i></a>
            <a href=""><i class="bi bi-instagram"></i></a>
            <a href=""><i class="bi bi-linkedin"></i></a>
        </div>
    </div>

</footer>
<!-- Scroll Top -->
<a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>


<!-- Vendor JS Files -->
<script src="assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="assets/vendor/php-email-form/validate.js"></script>
<script src="assets/vendor/aos/aos.js"></script>
<script src="assets/vendor/waypoints/noframework.waypoints.js"></script>
<script src="assets/vendor/purecounter/purecounter_vanilla.js"></script>
<script src="assets/vendor/swiper/swiper-bundle.min.js"></script>
<script src="assets/vendor/glightbox/js/glightbox.min.js"></script>
<script src="assets/vendor/imagesloaded/imagesloaded.pkgd.min.js"></script>
<script src="assets/vendor/isotope-layout/isotope.pkgd.min.js"></script>

<!-- Main JS File -->
<script src="assets/js/main.js"></script>
<script>
    const body = document.body;
    const btn = document.getElementById("themeToggle");

    const savedTheme = localStorage.getItem("theme") || "light-theme";
    body.classList.remove("light-theme", "dark-theme");
    body.classList.add(savedTheme);
    btn.textContent = savedTheme === "light-theme" ? "light_mode" : "dark_mode";

    btn.addEventListener("click", () => {
        if (body.classList.contains("light-theme")) {
            body.classList.replace("light-theme", "dark-theme");
            btn.textContent = "dark_mode";
            localStorage.setItem("theme", "dark-theme");
        } else {
            body.classList.replace("dark-theme", "light-theme");
            btn.textContent = "light_mode";
            localStorage.setItem("theme", "light-theme");
        }
    });

    const logo = document.querySelector(".navbar-brand img");

    if (savedTheme === "dark-theme") {
        logo.src = "/images/ShelfShare-KoyuTema.png";
    } else {
        logo.src = "/images/ShelfShare-AcikTema.png";
    }

</script>

@await RenderSectionAsync("Scripts", required: false)