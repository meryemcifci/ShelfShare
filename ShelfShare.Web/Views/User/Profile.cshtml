@model ShelfShare.Business.DTOs.CommonDto.UserDto
@{
    ViewData["Title"] = "Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="main">

    <!-- About Section -->
    <section id="about" class="about section">

        <!-- Section Title -->
        <div class="container section-title" data-aos="fade-up">
            <h2>Profilim</h2>
        @*     <p>Merhaba</p> *@
        </div><!-- End Section Title -->

        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <div class="row gy-4 justify-content-center">
                @if (Model != null)
                {
                    <div class="col-lg-4">
                        <img src="@(string.IsNullOrWhiteSpace(Model.ProfileImageUrl) ? Url.Content("~/images/BenimÜniversitelerim.jpg") : Model.ProfileImageUrl)" alt="Profil" class="img-fluid">
                    </div>
                    <div class="col-lg-8 content">
                        <h2>@Model.FirstName</h2>
                        <p class="fst-italic py-3">
                            @Model.Username
                        </p>
                        <div class="row">
                            <div class="col-lg-6">
                                <ul>
                                    <li>
                                        <i class="bi bi-chevron-right"></i> <strong>Doğum Günü:</strong> <span>
                                            @if (Model.Birthdate.HasValue)
                                            {
                                                <span>@Model.Birthdate.Value.ToString("dd.MM.yyyy")</span>
                                            }
                                            else
                                            {
                                                <span>(Tarih belirtilmemiş)</span>
                                            }
                                        </span>
                                    </li>
                                    <li><i class="bi bi-chevron-right"></i> <strong>Okuduğu Kitap Sayısı:</strong> <span>@Model.CompletedBooksCount</span></li>
                                        
                                </ul>
                            </div>
                            <div class="col-lg-6">
                                <ul>
                                    <li><i class="bi bi-chevron-right"></i> <strong>Okuma Hedefi:</strong> <span>@Model.TargetBooksCount</span></li>
                                    <li>
                                        <i class="bi bi-chevron-right"></i> <strong>Bulunduğu Grup:</strong> <span>
                                            @if (Model.GroupNames != null && Model.GroupNames.Any())
                                            {
                                               @string.Join(", ", Model.GroupNames)
                                            }
                                            else
                                            {
                                                <p>Henüz bir gruba katılmadın.</p>
                                            }
                                        </span>
                                    </li>
                                        
                                </ul>
                            </div>
                        </div>
                        <div>
                            <i class="bi bi-chevron-right"></i> <strong>Şu Anda Hangi Kitabı Okuyorum?:</strong> <span>@Model.Birthdate</span>
                        </div>
                    </div>
                    
                }
            </div>

        </div>

    </section><!-- /About Section -->
    <!-- Stats Section = İstatstikler Grafikler-->
    <section id="stats" class="stats section">

        <!-- Section Title -->
        <div class="container section-title" data-aos="fade-up">
            <h2>Facts</h2>
            <p>Necessitatibus eius consequatur ex aliquid fuga eum quidem sint consectetur velit</p>
        </div><!-- End Section Title -->

        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <div class="row gy-4">

                <div class="col-lg-3 col-md-6">
                    <div class="stats-item text-center w-100 h-100">
                        <span data-purecounter-start="0" data-purecounter-end="232" data-purecounter-duration="1" class="purecounter"></span>
                        <p>Clients</p>
                    </div>
                </div><!-- End Stats Item -->

                <div class="col-lg-3 col-md-6">
                    <div class="stats-item text-center w-100 h-100">
                        <span data-purecounter-start="0" data-purecounter-end="521" data-purecounter-duration="1" class="purecounter"></span>
                        <p>Projects</p>
                    </div>
                </div><!-- End Stats Item -->

                <div class="col-lg-3 col-md-6">
                    <div class="stats-item text-center w-100 h-100">
                        <span data-purecounter-start="0" data-purecounter-end="1453" data-purecounter-duration="1" class="purecounter"></span>
                        <p>Hours Of Support</p>
                    </div>
                </div><!-- End Stats Item -->

                <div class="col-lg-3 col-md-6">
                    <div class="stats-item text-center w-100 h-100">
                        <span data-purecounter-start="0" data-purecounter-end="32" data-purecounter-duration="1" class="purecounter"></span>
                        <p>Workers</p>
                    </div>
                </div><!-- End Stats Item -->

            </div>

        </div>

    </section><!-- /Stats Section -->
   

</main>

