@model List<ShelfShare.Entity.Concrete.Review>
@{
    ViewData["Title"] = "MyReviews";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<main class="main">

    <!-- Services Section -->
    <section id="services" class="services section">

        <!-- Section Title -->
        <div class="container section-title" data-aos="fade-up">
            <h2>Yorumlarım</h2>
            <p>Kitaplar hakkında düşüncelerim.</p>
        </div><!-- End Section Title -->

        <div class="container">

            <div class="row gy-4">
                @if (Model != null && Model.Any())
                {
                    foreach (var review in Model)
                    {
                        <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="600">
                            <div class="service-item item-pink position-relative">
                                <div class="icon">
                                    <svg width="100" height="100" viewBox="0 0 600 600" xmlns="http://www.w3.org/2000/svg">
                                        <path stroke="none" stroke-width="0" fill="#f5f5f5"
                                              d="M300,566.797414625762C385.7384707136149,576.1784315230908,478.7894351017131,552.8928747891023,
                                                    531.9192734346935,484.94944893311C584.6109503024035,417.5663521118492,582.489472248146,
                                                    322.67544863468447,553.9536738515405,242.03673114598146C529.1557734026468,171.96086150256528,
                                                    465.24506316201064,127.66468636344209,395.9583748389544,100.7403814666027C334.2173773831606,
                                                    76.7482773500951,269.4350130405921,84.62216499799875,207.1952322260088,107.2889140133804C132.92018162631612,
                                                    134.33871894543012,41.79353780512637,160.00259165414826,22.644507872594943,236.69541883565114C3.319112789854554,
                                                    314.0945973066697,72.72355303640163,379.243833228382,124.04198916343866,440.3218312028393C172.9286146004772,
                                                    498.5055451809895,224.45579914871206,558.5317968840102,300,566.797414625762"></path>
                                    </svg>
                                    <i class="bi bi-chat-square-text"></i>
                                </div>

                                <div class="review-content">
                                    <!-- Kitap Adı -->
                                    <h4 class="fw-bold">@review.Book?.Title</h4>

                                    <!-- Yıldızlı Puan Gösterimi -->
                                    <div class="mb-2">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= review.Rating)
                                            {
                                                <i class="bi bi-star-fill text-warning"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star text-warning"></i>
                                            }
                                        }
                                    </div>

                                    <!-- Yorum -->
                                    <p>@review.Comment</p>
                                </div>
                            </div>
                        </div>
                
                        <!-- End Service Item -->
                    }
                }
                else
                {
                    <p class="text-center text-muted">Henüz bir yorum yapmadınız.</p>
                }
            </div>

        </div>

    </section><!-- /Services Section -->

</main>
