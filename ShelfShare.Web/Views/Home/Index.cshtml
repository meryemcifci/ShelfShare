@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="main">

    <!-- Hero Section -->
    <section id="hero" class="hero section">

        <img src="~/images/hero-bg.jpg" alt="" data-aos="fade-in">

        <div class="container text-center" data-aos="zoom-out" data-aos-delay="100">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <h2 style="color:aliceblue !important">Shelf Share</h2>
                    <p style="color:aliceblue !important">Evinizdeki kitaplar ile dijital kütüphane oluşturmak ister misiniz?</p>
                    <a class="btn-get-started" asp-area="" asp-controller="Account" asp-action="Login">Giriş Yap</a>
                </div>
            </div>
        </div>

    </section><!-- /Hero Section -->

</main>

